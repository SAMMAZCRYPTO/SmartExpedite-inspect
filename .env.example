# Server-side configuration (never commit real secrets in production)
# Defaults fail-closed to 'production' if omitted or invalid; set 'dev' strictly for local testing
AUTH_MODE=dev
SX_DEMO=0
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRE_HOURS=24

# Database URL (SQLite locally; swap to PostgreSQL or SQL Server on corporate server)
# DATABASE_URL=postgresql+psycopg://inspectflow:password@localhost:5432/inspectflow
# DATABASE_URL=mssql+pyodbc://user:pass@server/inspectflow?driver=ODBC+Driver+18+for+SQL+Server

# Server-side AI key (never expose via VITE_* in browser bundle)
GEMINI_API_KEY=your-gemini-api-key

# CORS & File Storage
CORS_ORIGINS=http://localhost:5214,http://127.0.0.1:5214,http://localhost:5173,http://127.0.0.1:5173
UPLOAD_MAX_BYTES=52428800

# Microsoft Entra ID OIDC (used when AUTH_MODE=production)
# OIDC_TENANT_ID=
# OIDC_CLIENT_ID=
